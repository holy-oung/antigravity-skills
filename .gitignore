# ==============================================================================
# Antigravity Skill Vault .gitignore
# ==============================================================================

# 독립된 외부 리포지토리 제외 (독자 저장소로 관리)
inu-work-bot/

# 환경 변수 및 보안 키
.env
.env.*
!.env.example

# 파이썬 캐시 및 가상환경
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Node.js
node_modules/
npm-debug.log*

# 임시 스크린샷 및 로그
*.log
*.tmp
debug_*.png
step*.png
error_screenshot.png
result_screenshot.png

# OS 파일
.DS_Store
Thumbs.db
desktop.ini
