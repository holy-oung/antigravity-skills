{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bootstrap.js"],
            "timeout": 5,
            "statusMessage": "Loading senpai mode..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bootstrap.js"],
            "timeout": 5,
            "statusMessage": "Restoring senpai mode after compaction..."
          }
        ]
      }
    ]
  }
}
